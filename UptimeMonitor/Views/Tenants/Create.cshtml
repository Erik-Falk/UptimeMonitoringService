@model UptimeMonitor.Models.Tenant

<div class="card">
    <h1>Lägg till tenant</h1>
    <p>När en tenant skapas skickas URL:en till UptimeRobot för monitorering.</p>

    <div asp-validation-summary="All"></div>

    <form asp-action="Create" method="post">
        <div class="form-group">
            <label asp-for="Name">Namn</label>
            <input asp-for="Name" />
        </div>

        <div class="form-group">
            <label asp-for="Url">URL</label>
            <input asp-for="Url" placeholder="https://example.com" />
        </div>

        <div class="form-group">
            <label asp-for="SlaTarget">SLA-mål (%)</label>
            <input asp-for="SlaTarget" />
        </div>

        <button class="btn" type="submit">Skapa tenant</button>
    </form>
</div>